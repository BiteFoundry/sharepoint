{
  "name": "@bitefoundry/sharepoint",
  "version": "0.1.4",
  "description": "Unified Microsoft SharePoint & OneDrive terminal client & AI agent toolkit — Sites, Document Libraries & Personal Files (CLI, TUI, HTTP API, MCP)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiteFoundry/sharepoint.git"
  },
  "license": "MIT",
  "bin": {
    "sharepoint": "bin/sharepoint.js",
    "sp": "bin/sp.js",
    "onedrive": "bin/onedrive.js",
    "od": "bin/od.js"
  },
  "files": [
    "bin/sharepoint.js",
    "bin/sp.js",
    "bin/onedrive.js",
    "bin/od.js",
    "scripts/postinstall.mjs",
    "docs/NPM.md",
    "docs/API.md",
    "docs/MCP.md",
    "docs/openapi.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "microsoft-sharepoint",
    "sharepoint",
    "onedrive",
    "microsoft-365",
    "microsoft-graph",
    "document-library",
    "cloud-storage",
    "cli",
    "tui",
    "mcp"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "build:npm": "node scripts/build-npm.mjs"
  },
  "optionalDependencies": {
    "@bitefoundry/sharepoint-win32-x64": "0.1.4",
    "@bitefoundry/sharepoint-win32-arm64": "0.1.4",
    "@bitefoundry/sharepoint-darwin-x64": "0.1.4",
    "@bitefoundry/sharepoint-darwin-arm64": "0.1.4",
    "@bitefoundry/sharepoint-linux-x64": "0.1.4",
    "@bitefoundry/sharepoint-linux-arm64": "0.1.4"
  }
}
